# This repository is mounted as the students' home (/home/studente) in the container.

# Dotfiles and caches created in the home (.bashrc, .cache, .vscode-server, .ros, ...)
/.*
!/.gitignore

# colcon build output
/aimdk/build/
/aimdk/install/
/aimdk/log/
__pycache__/
*.pyc

# AgiBot HTML documentation (~170 MB): copied from the robot SDK by setup-studenti.sh,
# also available online at https://x2-aimdk.agibot.com
/aimdk/docs/

# Generated by foxglove/run.sh
/foxglove/urdf_prefix/

# Groups' ROS 2 workspaces (students' own code, not part of this repository)
/*_ws/

# Output of the examples
images/
audio_recordings/
